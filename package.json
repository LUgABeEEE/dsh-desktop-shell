{
  "name": "dsh-desktop-shell",
  "version": "0.1.0",
  "description": "Desktop OS integration for DeepSeek Harness: global hotkey, native notifications, screenshot capture, clipboard watch.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./hotkey": {
      "types": "./lib/hotkey.d.ts",
      "default": "./lib/hotkey.js"
    },
    "./notify": {
      "types": "./lib/notify.d.ts",
      "default": "./lib/notify.js"
    },
    "./capture": {
      "types": "./lib/capture.d.ts",
      "default": "./lib/capture.js"
    },
    "./clipboard": {
      "types": "./lib/clipboard.d.ts",
      "default": "./lib/clipboard.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:lib": "tsc -p tsconfig.json && git diff --exit-code -- lib",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "npm run typecheck && npm run check:lib && npm run check:docs && npm test"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-desktop-shell",
    "summary": "DeepSeek Harness 桌面 OS 集成：任务完成/待审批系统通知、截图进会话、剪贴板读取与监听、全局热键。内容仅本机处理，不上传。",
    "categories": [
      "系统集成",
      "效率"
    ],
    "surfaces": [
      "host"
    ],
    "capabilities": {
      "provides": [
        "tool:desktop_notify",
        "tool:desktop_capture_screen",
        "tool:desktop_read_clipboard"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2",
      "node": ">=20"
    },
    "permissions": {
      "network": [],
      "clipboard": "read-on-demand",
      "screenCapture": "on-demand"
    },
    "notes": "热键无法聚焦 DSH 窗口（宿主无窗口 seam），按键改为弹通知；截图无拖拽框选，region 需显式坐标；剪贴板监听为轮询且默认关闭。"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "desktop",
    "hotkey",
    "notification",
    "screenshot",
    "clipboard"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "clipboardy": "^5.3.2",
    "node-notifier": "^11.0.0",
    "screenshot-desktop": "^1.15.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/node-notifier": "^8.0.5",
    "@types/screenshot-desktop": "^1.15.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
