{
  "name": "dsh-desktop-shell",
  "version": "0.1.0",
  "description": "Desktop OS integration for DeepSeek Harness: global hotkey, native notifications, screenshot capture, clipboard watch.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./hotkey": {
      "types": "./lib/hotkey.d.ts",
      "default": "./lib/hotkey.js"
    },
    "./notify": {
      "types": "./lib/notify.d.ts",
      "default": "./lib/notify.js"
    },
    "./capture": {
      "types": "./lib/capture.d.ts",
      "default": "./lib/capture.js"
    },
    "./clipboard": {
      "types": "./lib/clipboard.d.ts",
      "default": "./lib/clipboard.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:lib": "tsc -p tsconfig.json && git diff --exit-code -- lib",
    "verify": "npm run typecheck && npm run check:lib && npm test"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "desktop",
    "hotkey",
    "notification",
    "screenshot",
    "clipboard"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/node-notifier": "^8.0.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
